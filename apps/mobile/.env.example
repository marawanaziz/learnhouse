# Copy to .env.local. These are identifiers, not signing credentials.
# Preview runs without any values below. Production identity/version defaults
# are pinned to the verified existing listings in release/store-targets.json.
APP_VARIANT=preview
EXPO_OWNER=
EAS_PROJECT_ID=
# Optional overrides must match the existing listings exactly.
BBU_IOS_BUNDLE_ID=com.birthandbabyuniversity.learn
BBU_ANDROID_PACKAGE=com.birthandbabyuniversity.learn
BBU_APPLE_TEAM_ID=2V6MAB58ZP
# Optional version overrides must exceed the recorded store versions/builds.
BBU_APP_VERSION=
BBU_IOS_BUILD_NUMBER=
BBU_ANDROID_VERSION_CODE=
