# EAS archives the repository root. Only the self-contained mobile app is needed.
/*
!/apps/
/apps/*
!/apps/mobile/

**/node_modules/
**/.expo/
**/dist/
**/web-build/
/apps/mobile/ios/
/apps/mobile/android/
/apps/mobile/signing/
/apps/mobile/artifacts/
**/.DS_Store
**/.env*
!apps/mobile/.env.example
**/credentials.json
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.mobileprovision
**/*.ipa
**/*.apk
**/*.aab
**/*debug.log*
**/*.tsbuildinfo
**/__pycache__/
